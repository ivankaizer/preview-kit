#!/usr/bin/env bash
# preview — per-PR preview environments on Dokploy, with recorded demos.
# Run inside a repository; see README.md.
set -euo pipefail
kit=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
config="${PREVIEW_CONFIG:-.preview/config.json}"
export PREVIEW_CONFIG="$config"

usage() {
  cat <<'EOF'
usage: preview <command>

  init [project]   scaffold .preview/, docker-compose.preview.yml and the cleanup workflow
  onboard          one-time setup for this repo: Dokploy project, deploy key, CI secret
  deploy           deploy this branch's PR and print the preview URL
  staging deploy   deploy the staging branch to https://<project>.<domain> (also: url, destroy)
  prod build|deploy <tag>   build and push the production images / deploy them (also: prod url)
  db setup         create the server's shared Postgres, used by staging stacks (also: status)
  demo             record the tour on the preview and compare with the previous commit
  url              print this branch's preview URL
  status           list this project's previews
  prune            remove previews whose pull request is no longer open
  destroy          remove this branch's preview and its demos
  version          print the kit version

Credentials: DOKPLOY_API_KEY from the environment or ~/.env (never commit it).
PR_NUMBER/BRANCH default to the PR of the checked-out branch (via gh).
EOF
}

die() { echo "preview: $*" >&2; exit 1; }

# Repo and major version this kit was installed from, so generated workflows point back at it.
# Forks work unchanged: the origin remote decides.
kit_repo() {
  local remote
  remote=$(git -C "$kit" remote get-url origin 2>/dev/null || true)
  remote=${remote%.git}
  remote=${remote#*github.com[:/]}
  echo "${remote:-ivankaizer/preview-kit}"
}
PREVIEW_KIT_REPO="${PREVIEW_KIT_REPO:-$(kit_repo)}"
PREVIEW_KIT_REF="${PREVIEW_KIT_REF:-v$(cut -d. -f1 "$kit/VERSION")}"
export PREVIEW_KIT_REPO PREVIEW_KIT_REF

require_config() { [[ -f $config ]] || die "missing $config; run 'preview init' in the repo root first"; }

load_env() {
  if [[ -z ${DOKPLOY_API_KEY:-} && -f $HOME/.env ]]; then
    set -a
    # shellcheck disable=SC1091
    source "$HOME/.env"
    set +a
  fi
  if [[ -z ${DOKPLOY_URL:-} && -f $config ]]; then DOKPLOY_URL=$(jq -r '.dokploy // empty' "$config"); fi
  [[ -n ${DOKPLOY_URL:-} ]] || die "set \"dokploy\" in $config or DOKPLOY_URL"
  [[ -n ${DOKPLOY_API_KEY:-} ]] || die "missing DOKPLOY_API_KEY (CI secret, or ~/.env locally)"
  export DOKPLOY_URL DOKPLOY_API_KEY
}

pr_context() {
  REPO="${REPO:-${GITHUB_REPOSITORY:-$(gh repo view --json nameWithOwner --jq .nameWithOwner)}}"
  if [[ -z ${PR_NUMBER:-} || -z ${BRANCH:-} ]]; then
    read -r PR_NUMBER BRANCH SHA <<<"$(gh pr view --json number,headRefName,headRefOid \
      --jq '"\(.number) \(.headRefName) \(.headRefOid)"' 2>/dev/null || true)"
    [[ -n ${PR_NUMBER:-} ]] || die "no open pull request for this branch; open one, or set PR_NUMBER and BRANCH"
  fi
  export REPO PR_NUMBER BRANCH SHA="${SHA:-}"
}

previews() { # prints "<composeId> <name> <status> <created> <description>" for this project
  local project env_id
  project=$(jq -r .project "$config")
  env_id=$(dokploy project.all | jq -r --arg p "$project" \
    '[.[] | select(.name == $p) | .environments[]? | select(.name == "previews") | .environmentId][0] // empty')
  [[ -n $env_id ]] || die "project $project is not onboarded; run 'preview onboard'"
  dokploy "environment.one?environmentId=$env_id" | jq -r \
    '.compose[]? | "\(.composeId) \(.name) \(.composeStatus) \(.createdAt[0:16]) \(.description // "")"'
}
dokploy() { curl -fsS -H "x-api-key: $DOKPLOY_API_KEY" "${DOKPLOY_URL%/}/api/$1"; }

cmd=${1:-help}
shift || true
case $cmd in
  init) exec "$kit/lib/init.sh" "$@" ;;
  onboard) load_env; exec "$kit/lib/onboard.sh" "$@" ;;
  deploy | url)
    load_env; pr_context
    "$kit/lib/preview.sh" "$cmd"
    ;;
  destroy)
    load_env; pr_context
    "$kit/lib/preview.sh" destroy
    if GH_TOKEN="${GH_TOKEN:-$(gh auth token 2>/dev/null || true)}" \
      gh api -X DELETE "repos/$REPO/git/refs/heads/demos/pr-$PR_NUMBER" >/dev/null 2>&1; then
      echo "Deleted demos/pr-$PR_NUMBER" >&2
    fi
    ;;
  demo)
    load_env; pr_context
    command -v ffmpeg >/dev/null || die "demo needs ffmpeg"
    command -v node >/dev/null || die "demo needs node"
    [[ -d $kit/lib/demo/node_modules ]] || (cd "$kit/lib/demo" && npm ci --no-audit --no-fund --silent)
    [[ -n $SHA ]] || SHA=$(gh pr view "$PR_NUMBER" -R "$REPO" --json headRefOid --jq .headRefOid)
    PREVIEW_URL="${PREVIEW_URL:-$("$kit/lib/preview.sh" url)}"
    GH_TOKEN="${GH_TOKEN:-$(gh auth token)}"
    export PREVIEW_URL GH_TOKEN SHA
    "$kit/lib/demo/run.sh"
    ;;
  staging)
    require_config; load_env
    REPO="${REPO:-${GITHUB_REPOSITORY:-$(gh repo view --json nameWithOwner --jq .nameWithOwner)}}"
    SHA="${SHA:-${GITHUB_SHA:-$(git rev-parse HEAD 2>/dev/null || true)}}"
    export REPO SHA
    exec "$kit/lib/staging.sh" "${1:-deploy}"
    ;;
  prod)
    require_config; load_env
    exec "$kit/lib/prod.sh" "$@"
    ;;
  db)
    load_env
    case ${1:-} in
      setup | status) exec "$kit/lib/shared-db.sh" "$1" ;;
      *) die "usage: preview db setup|status" ;;
    esac
    ;;
  status)
    require_config; load_env
    { printf 'PREVIEW\tSTATUS\tCREATED\tDESCRIPTION\n'
      previews | while read -r _ name status created description; do
        printf '%s\t%s\t%s\t%s\n' "$name" "$status" "$created" "$description"
      done; } | column -t -s $'\t'
    ;;
  prune)
    require_config; load_env
    REPO="${REPO:-$(gh repo view --json nameWithOwner --jq .nameWithOwner)}"
    previews | while read -r _ name _; do
      number=${name#pr-}
      state=$(gh pr view "$number" -R "$REPO" --json state --jq .state 2>/dev/null || echo UNKNOWN)
      case $state in
        OPEN) echo "keep    $name (open)" ;;
        UNKNOWN) echo "skip    $name (PR not found)" ;;
        *)
          echo "remove  $name ($(tr '[:upper:]' '[:lower:]' <<<"$state"))"
          REPO=$REPO PR_NUMBER=$number BRANCH=unknown "$0" destroy </dev/null
          ;;
      esac
    done
    ;;
  version | --version) cat "$kit/VERSION" ;;
  help | -h | --help) usage ;;
  *) usage >&2; exit 2 ;;
esac
